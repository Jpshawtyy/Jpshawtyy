 "frases": [
  {
   "fala": "Mais de seis mil e quinhentos dólares.",
   "duracao": 2.185714
  },
  {
   "fala": "Por um deck que ganhou Regional.",
   "duracao": 1.680091
  },
  {
   "fala": "Os campeões de outubro,",
   "duracao": 1.513605
  },
  {
   "fala": "com a versão mais rara de cada carta.",
   "duracao": 2.161678
  },
  {
   "fala": "No topo, a Basic Box:",
   "duracao": 1.486667
  },
  {
   "fala": "seis mil, quinhentos e trinta e quatro dólares.",
   "duracao": 2.692268
  },
  {
   "fala": "Mesmo ataque, mesmo dano.",
   "duracao": 1.532381
  },
  {
   "fala": "Um custa oitenta e quatro centavos.",
   "duracao": 2.14873
  },
  {
   "fala": "O outro, setenta e seis dólares.",
   "duracao": 2.013311
  },
  {
   "fala": "A carta mais cara nem é Pokémon",
   "duracao": 2.020726
  },
  {
   "fala": "É esta Ultra Ball dourada, de dois mil e treze.",
   "duracao": 2.490726
  },
  {
   "fala": "Quatro cópias:",
   "duracao": 0.985057
  },
  {
   "fala": "quase quatro mil e oitocentos dólares.",
   "duracao": 2.306803
  },
  {
   "fala": "O poder é o mesmo: só muda a arte.",
   "duracao": 1.966463
  },
  {
   "fala": "O Dragapult campeão",
   "duracao": 1.392925
  },
  {
   "fala": "sai por trinta e três dólares, na versão mais barata.",
   "duracao": 2.902517
  },
  {
   "fala": "Salva pra montar o seu, e segue a Escola Umbra.",
   "duracao": 2.442336
  }
