  {
   "fala": "Da loja ao Mundial.",
   "duracao": 1.303175
  },
  {
   "fala": "os cinco níveis de campeonato",
   "duracao": 1.801088
  },
  {
   "fala": "Começa na sua loja: quinze pontos pro campeão.",
   "duracao": 2.613084
  },
  {
   "fala": "Um torneio maior, ainda na loja: cinquenta.",
   "duracao": 2.2861
  },
  {
   "fala": "O Regional: duzentos. O de Recife teve mais de mil jogadores.",
   "duracao": 3.586145
  },
  {
   "fala": "O Internacional: quinhentos.",
   "duracao": 1.67517
  },
  {
   "fala": "E no topo, o Mundial: em dois mil e vinte e sete, em Singapura.",
   "duracao": 3.535351
  },
  {
   "fala": "O Internacional é em São Paulo, dia vinte de novembro.",
   "duracao": 3.066599
  },
  {
   "fala": "E em março tem Regional no Rio",
   "duracao": 1.84805
  },
  {
   "fala": "Cada torneio dá pontos",
   "duracao": 1.486349
  },
  {
   "fala": "que somam a temporada toda",
   "duracao": 1.536168
  },
  {
   "fala": "Quem soma mais é convidado pro Mundial",
   "duracao": 2.29381
  },
  {
   "fala": "O primeiro nível é aberto pra qualquer jogador",
   "duracao": 2.582585
  },
  {
   "fala": "Salva pro seu primeiro torneio, e segue a Escola Umbra.",
   "duracao": 2.981474
