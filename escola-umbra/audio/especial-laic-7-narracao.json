 "frases": [
  {
   "fala": "O campeão do Laique é brasileiro!",
   "duracao": 1.842313
  },
  {
   "fala": "Vinícius Fernandez, de N's Zoroark.",
   "duracao": 2.012381
  },
  {
   "fala": "Um em cada três no dia dois era Dragapult.",
   "duracao": 2.574059
  },
  {
   "fala": "E o campeão veio de Zoroark, com menos de dez por cento.",
   "duracao": 2.990522
  },
  {
   "fala": "O Night Joker copia o ataque do N's Zekrom do banco:",
   "duracao": 2.777098
  },
  {
   "fala": "duzentos e cinquenta, com só duas energias.",
   "duracao": 2.561769
  },
  {
   "fala": "Contra o Dragapult, com trezentos e vinte de HP:",
   "duracao": 2.944626
  },
  {
   "fala": "Night Joker copiando o Zekrom: duzentos e cinquenta.",
   "duracao": 2.958503
  },
  {
   "fala": "Envenenado pelo Pecharunt, o Mochi dá mais quarenta.",
   "duracao": 2.999138
  },
  {
   "fala": "Black Belt's Training: mais quarenta. Nocaute!",
   "duracao": 2.47263
  },
  {
   "fala": "Quatro Zorua e quatro Zoroark.",
   "duracao": 1.927143
  },
  {
   "fala": "Zekrom, Pecharunt e Munkidori no banco.",
   "duracao": 2.253855
  },
  {
   "fala": "Quatro N's PP Up, que trazem energia do descarte.",
   "duracao": 2.86542
  },
  {
   "fala": "E Mochi com Black Belt: mais oitenta.",
   "duracao": 2.125057
  },
  {
   "fala": "Parabéns, Vinícius! Salva a lista campeã e segue a Escola Umbra.",
   "duracao": 3.623469
  }
 ],
