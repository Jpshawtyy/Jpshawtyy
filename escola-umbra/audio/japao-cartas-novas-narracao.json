 "frases": [
  {
   "fala": "Os decks com as cartas novas já começaram a aparecer no Japão.",
   "duracao": 3.646893
  },
  {
   "fala": "Olha os protótipos!",
   "duracao": 1.331134
  },
  {
   "fala": "A carta que mais tão testando é o Mega Lucario Z ex.",
   "duracao": 3.037506
  },
  {
   "fala": "No ativo, o Aura Seeker busca qualquer Apoiador.",
   "duracao": 2.748254
  },
  {
   "fala": "E o Dancing Fist bate cento e vinte, ou duzentos e quarenta contra ex.",
   "duracao": 4.111383
  },
  {
   "fala": "A base mais testada é Lucario com Dudunsparce pra comprar.",
   "duracao": 3.298934
  },
  {
   "fala": "Tem lista com Grand Tree no lugar, e até misturando Garchomp.",
   "duracao": 3.22517
  },
  {
   "fala": "E tem uma Apoiadora nova da Korrina.",
   "duracao": 2.139002
  },
  {
   "fala": "Ela dá mais vinte de dano pros Mega ex, pra cada prêmio que o oponente pegou.",
   "duracao": 4.509002
  },
  {
   "fala": "Com quatro prêmios, o Lucario bate trezentos e vinte: nocaute no Dragapult.",
   "duracao": 4.348209
  },
  {
   "fala": "Bem menos testado: o Mega Absol Z ex.",
   "duracao": 2.436939
  },
  {
   "fala": "Bate cento e sessenta, e trava Energia Especial e Estádio do oponente.",
   "duracao": 4.135011
  },
  {
   "fala": "O segundo mais testado é o Mega Garchomp Z ex.",
   "duracao": 2.786395
  },
  {
   "fala": "Bate trinta pra cada Pokémon Dragão no descarte,",
   "duracao": 2.840295
  },
  {
   "fala": "e tem um ataque de duzentos e quarenta que bate até no Crustle.",
   "duracao": 3.499592
  },
  {
   "fala": "As listas usam o Drakloak pra comprar,",
   "duracao": 2.38
  },
  {
   "fala": "e o Vibrava, que vai pro descarte, dá dano pro Garchomp e mostra a carta do topo.",
   "duracao": 4.160181
  },
  {
   "fala": "E um diferentão: o Sceptile ex.",
   "duracao": 1.838685
  },
  {
   "fala": "Com uma energia, bate quarenta e envenena.",
   "duracao": 2.324104
  },
  {
   "fala": "E com duas, cento e sessenta, mais cinquenta por Condição Especial.",
   "duracao": 3.922132
  },
  {
   "fala": "Quer um vídeo explicando cada um desses decks? Comenta aí!",
   "duracao": 2.983265
  }
 ],
