  {
   "fala": "Recuar: a saída de emergência.",
   "duracao": 1.86093
  },
  {
   "fala": "Uma vez por turno, pagando energia.",
   "duracao": 2.009342
  },
  {
   "fala": "Olha o custo de recuo, no pé da carta.",
   "duracao": 2.061837
  },
  {
   "fala": "Descarta essa energia do ativo.",
   "duracao": 1.901678
  },
  {
   "fala": "E troca com o banco. Só uma vez por turno.",
   "duracao": 2.439388
  },
  {
   "fala": "O Drakloak tá com setenta de dano. Recua!",
   "duracao": 2.40746
  },
  {
   "fala": "Pagou uma energia.",
   "duracao": 1.132472
  },
  {
   "fala": "E o Dragapult entra batendo.",
   "duracao": 1.860726
  },
  {
   "fala": "Nocaute. E o Drakloak ficou salvo no banco.",
   "duracao": 2.535215
  },
  {
   "fala": "Vai cair? Recua e não entrega prêmio.",
   "duracao": 2.033764
  },
  {
   "fala": "Confronto ruim: sobe quem bate mais.",
   "duracao": 2.286893
  },
  {
   "fala": "Confuso ou envenenado? No banco, sai.",
   "duracao": 2.232721
  },
  {
   "fala": "O Switch troca o ativo sem pagar nada,",
   "duracao": 2.402812
  },
  {
   "fala": "e não conta como o recuo do turno.",
   "duracao": 1.843764
  },
  {
   "fala": "Dormindo ou paralisado não recua.",
   "duracao": 1.996395
  },
  {
   "fala": "Aí, só com Switch.",
   "duracao": 1.156893
  },
  {
   "fala": "Salva, e segue a Escola Umbra.",
   "duracao": 1.634218
  }
